#need to be careful in using these if one has been using modp=true in the MazurTate(...) command, namely, ensure mu=0 by scaling if needed. 
def lambda_inv(poly,p):
    """
    Returns the Iwasawa lambda-invariant for p of a polynomial.
    This algorithm differs from the ones currently used because most of our computations are done for polynomials of mu-invariant = 0.
    """
    m = mu_inv(poly,p)
    if poly == 0:
        return oo
    else:
        v = [poly[a].valuation(p) for a in range(poly.degree() + 1)]
        return v.index(m)


